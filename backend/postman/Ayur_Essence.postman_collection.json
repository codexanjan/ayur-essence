    },
    {
      "name": "03 Questionnaire",
      "item": [
        {
          "name": "Get Active Questions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/questions", "host": ["{{baseUrl}}"], "path": ["api", "questions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Questions loaded (200)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Returns active questions list', function () {",
                  "  pm.expect(json.data.questions).to.be.an('array').and.not.empty;",
                  "});",
                  "if (json.data.questions.length > 0) {",
                  "  pm.collectionVariables.set('q0_id', json.data.questions[0].id);",
                  "  pm.collectionVariables.set('q0_opt0', json.data.questions[0].options[0]);",
                  "  pm.collectionVariables.set('q0_opt1', json.data.questions[0].options[1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
