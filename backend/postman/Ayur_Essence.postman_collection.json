          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Patient matches ID', function () { pm.expect(json.data.patient.id).to.eql(pm.collectionVariables.get('patientId')); });"
                ],
                "type": "text/javascript"
