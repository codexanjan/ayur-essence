            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/finalize", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "finalize"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Finalize succeeds (200)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Status is FINALIZED', function () { pm.expect(json.data.status).to.eql('FINALIZED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reopen Assessment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Revision requested during practitioner review\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/reopen", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "reopen"] }
          },
          "event": [
            {
              "listen": "test",
