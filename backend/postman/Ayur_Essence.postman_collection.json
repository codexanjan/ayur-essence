        }
      ]
    },
    {
      "name": "04 Assessments",
      "item": [
        {
          "name": "Start Assessment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
