        {
          "name": "Save Responses",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responses\": [\n    {\n      \"questionId\": \"{{q0_id}}\",\n      \"responseValue\": \"{{q0_opt0}}\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/responses", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "responses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responses saved (200)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Snapshot stored', function () { pm.expect(json.data.responses[0].scoringSnapshot).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Same Responses (Upsert)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responses\": [\n    {\n      \"questionId\": \"{{q0_id}}\",\n      \"responseValue\": \"{{q0_opt1}}\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/responses", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "responses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upsert succeeds (200)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Value updated cleanly', function () {",
                  "  pm.expect(json.data.responses[0].responseValue).to.eql(pm.collectionVariables.get('q0_opt1'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Scoring",
      "item": [
        {
          "name": "Submit All Required Answers",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/questions',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('doctorToken') }",
                  "}, function (err, res) {",
                  "  if (!err) {",
                  "    const questions = res.json().data.questions;",
                  "    const responses = questions.map(q => ({ questionId: q.id, responseValue: q.options[0] }));",
                  "    pm.collectionVariables.set('allResponsesPayload', JSON.stringify({ responses: responses }));",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All answers saved (200)', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{allResponsesPayload}}"
            },
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/responses", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "responses"] }
          }
        },
        {
          "name": "Calculate Prakriti Result",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/assessments/{{assessmentId}}/calculate", "host": ["{{baseUrl}}"], "path": ["api", "assessments", "{{assessmentId}}", "calculate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Calculation succeeds (200)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const result = json?.data?.result || json?.data;",
                  "const vata = Number(result.vataPct);",
                  "const pitta = Number(result.pittaPct);",
                  "const kapha = Number(result.kaphaPct);",
                  "pm.test('Dosha percentages are numbers', function () {",
                  "  pm.expect(vata).to.be.a('number');",
                  "  pm.expect(pitta).to.be.a('number');",
                  "  pm.expect(kapha).to.be.a('number');",
                  "});",
                  "pm.test('Dosha percentages total approximately 100', function () {",
                  "  pm.expect(vata + pitta + kapha).to.be.within(99.9, 100.1);",
                  "});",
                  "pm.test('Dominant Dosha is valid', function () {",
                  "  pm.expect(['VATA', 'PITTA', 'KAPHA', 'VATA-PITTA', 'VATA-KAPHA', 'PITTA-KAPHA', 'TRIDOSHA']).to.include(result.dominantDosha);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
