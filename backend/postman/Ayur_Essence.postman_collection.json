          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Assessment created (201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const json = pm.response.json();",
                  "const assessmentId = json?.data?.assessment?.id || json?.data?.assessmentId || json?.data?.id;",
                  "pm.test('assessmentId returned', function () { pm.expect(assessmentId).to.be.a('string').and.not.empty; });",
                  "if (assessmentId) { pm.collectionVariables.set('assessmentId', assessmentId); }"
