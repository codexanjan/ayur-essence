                  "pm.test('Patient created (201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const json = pm.response.json();",
                  "const patientId = json?.data?.patient?.id || json?.data?.id;",
                  "pm.test('patientId returned', function () { pm.expect(patientId).to.be.a('string').and.not.empty; });",
                  "if (patientId) { pm.collectionVariables.set('patientId', patientId); }"
